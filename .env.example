# No environment variables are required to run this site.
#
# Optional: the public address of your deployed site (used for social-sharing metadata).
# Example: https://your-name.vercel.app
NEXT_PUBLIC_SITE_URL=

# Future data-dashboard connections: keep API keys SERVER-SIDE only.
# Do NOT prefix secrets with NEXT_PUBLIC_ (that would expose them in the browser).
# DATA_API_KEY=
